{
  "name": "Collab-Canvas",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start:http": "pnpm --filter=http-backend start",
    "start:ws": "pnpm --filter=ws-backend start",
    "db:migrate": "turbo run build --filter=@repo/db && npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.5.4",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "tsx": "^4.21.0"
  }
}
